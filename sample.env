# Telemetry files
FIT_FILE="data/activity.fit"
TCX_FILE="data/activity.tcx"
CSV_FILE="data/output/activity.csv"

# Video merge settings
INPUT_VIDEO_PATH="/mnt/v/media/video/dji/internal_storage/DCIM/DJI_001/DJI_20260409152956_0001_D.MP4"
INPUT_VIDEO_FPS="59.94"
OUTPUT_VIDEO_PATH="output_nvenc.mp4"
START_TIME="00:00:00"
END_TIME="00:19:00"

# FFMPEG settings
# libx265 for CPU encoding, hevc_nvenc for NVIDIA GPU encoding
FFMPEG_ENCODER="hevc_nvenc"
FFMPEG_BITRATE="30M"
FFMPEG_MAXBITRATE="40M"
FFMPEG_BUFSIZE="15M"
FFMPEG_PRESET="slow"
FFMPEG_TUNE="hq"
FFMPEG_PROFILE="main10"
# constqp for constant QP mode, vbr for variable bitrate mode
FFMPEG_RC="vbr"
# number of frames the encoder should look ahead to analyze the video content (32 - 40)
FFMPEG_RC_LOOKAHEAD="32"
# -qp value for constant QP mode (lower is better quality, higher is more compression)
FFMPEG_QP="21"
# -cq value for variable bitrate mode (lower is better quality, higher is more compression)
FFMPEG_CQ="19"
FFMPEG_QMIN="1"
FFMPEG_QMAX="51"
FFMPEG_CRF="21"
FFMPEG_PIX_FMT="p010le" # yuv420p10le for CPU encoding, p010le for NVIDIA GPU encoding
FFMPEG_LIBX265_PARAMS="no-aq-motion=1:aq-mode=3"

# Processing settings
# seconds
TIME_TOLERANCE="2"
# for gradient calculation
WINDOW_METERS="50"
# seconds to decrease speed/cadence at start of gap
DECREASE_WINDOW="5"
# seconds to increase speed/cadence at end of gap
INCREASE_WINDOW="5"
# milliseconds between each row in output CSV
TIMESTAMP_STEP_MS="500"

# Overlay frames settings
OUTPUT_FOLDER="frames"
OVERLAY_WIDTH="1920"
OVERLAY_HEIGHT="1080"
# Absolue font path
FONT_PATH="/usr/share/fonts/truetype/jetbrains-mono/JetBrainsMono-Regular.ttf"
# FONT_PATH="/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf"
# FONT_PATH="/usr/share/fonts/truetype/quicksand/Quicksand-Regular.ttf"
# FONT_PATH="/usr/share/fonts/truetype/liberation/LiberationMono-Regular.ttf"
# FONT_PATH="/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf"
# FONT_PATH="/usr/share/fonts/truetype/crosextra/Carlito-Regular.ttf"
# FONT_PATH="/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"

# For debugging purposes, break after the first frame to verify output before processing the entire dataset
OVERLAY_DEBUG="False"

